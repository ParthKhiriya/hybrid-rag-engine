APP_ENV=development
LOG_LEVEL=INFO
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hybrid_rag_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hybrid-rag-demo
NEO4J_DATABASE=neo4j

EMBEDDING_DIM=384
TOP_K_VECTOR=8
TOP_K_GRAPH=8
RRF_K=60
GRAPH_MAX_HOPS=3
ALLOW_IN_MEMORY_FALLBACK=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hybrid-rag-engine

# RBAC: comma-separated API keys per role. Leave unset in development to
# use the demo defaults below; ALWAYS set unique, secret values before any
# non-local deployment. An admin key also satisfies writer/reader checks.
API_KEYS_READER=demo-reader-key
API_KEYS_WRITER=demo-writer-key
API_KEYS_ADMIN=demo-admin-key

# Content safety
BLOCK_QUARANTINED_INGEST=false
EXCLUDE_QUARANTINED_FROM_CONTEXT=true
